#
# Release image for the CUDA-Q QEC decoding server. Multi-stage: the
# "toolchain" and "builder" stages (compilers, dev headers, source tree)
# are discarded; the final "runtime" stage ships only compiled binaries
# and runtime dependencies. No cudaqx or proprietary source is included.
#
# CUDA-Q is NOT built here: the /opt/nvidia/cudaq install is taken from
# the official published CUDA-Q container (cudaq_image below) and used
# whole in the builder stage; the runtime stage ships only its lib/
# directory (proprietary simulator backends included) and license files.
# Only two things are compiled:
#   cudaq-realtime -- rebuilt with HSB tools ON (the official install
#     ships it without them), from the exact cuda-quantum commit the
#     consumed image was built at. This repo's .cudaq_version does not
#     govern this image.
#   cudaqx/qec -- this repo's own code: decoding_server, decoder
#     plugins, hsb_fpga_syndrome_playback.
#
# Prebuilt proprietary artifacts (decoder plugin .so files, the cudevice
# archive enabling device_graph dispatch) are supplied via an optional
# build context with a flat layout:
#
#   artifacts/
#     libcudaq-qec-<name>-decoder.so   (any number of decoder plugins)
#     libcudaq-qec-realtime-cudevice-proprietary.a
#
# Each is independently optional (as is the build context itself): a
# missing plugin is simply absent from the image; without the cudevice
# archive, device_graph dispatch is not linked (host-dispatch decoders
# still work). In CI, build_decoding_server_docker.yaml populates this
# from a draft-release asset.
#
# Build (from the repo root):
#   DOCKER_BUILDKIT=1 docker build -f docker/release/Dockerfile.decoding-server \
#     --build-arg CUDA_VERSION=13.0 \
#     --build-context artifacts=./path/to/artifacts \
#     -t cudaqx-decoding-server .
#
# If overriding CUDA_VERSION (e.g. to 12.6), also pass a matching
# cudaq_image and cuda_base_image_tag -- see the args below; they
# aren't derived from each other.

ARG CUDA_VERSION=13.0
ARG TARGETARCH
# The official published CUDA-Q container whose /opt/nvidia/cudaq install
# is consumed at build time and whose lib/ is shipped in the final image.
#   nightly (tracks cuda-quantum main): nvcr.io/nvidia/nightly/cuda-quantum:cu<major>-latest
#   releases (retained, versioned):     nvcr.io/nvidia/quantum/cuda-quantum:cu<major>-<version>
# Release builds should pin a versioned release image. 0.16.0 is the first
# release with in-container realtime support; earlier releases cannot be used.
ARG cudaq_image=nvcr.io/nvidia/nightly/cuda-quantum:cu13-latest
# Toolchain for compiling cudaq-realtime and cudaqx/qec: gcc-12, CUDA
# toolkit, and the LLVM/MLIR dev install CUDA-Q builds against, from the
# same lineage the official CUDA-Q build uses. Only branch-suffixed
# floating tags exist for this image; fine for current builds (nothing
# from it ships, and toolchain drift tends to fail at build time rather
# than yielding a mismatched binary), but it makes rebuilding an old
# release image tricky: by then this tag may serve a newer toolchain than
# that release builds against.
ARG devcontainer_image=ghcr.io/nvidia/cuda-quantum-devcontainer
ARG devcontainer_tag_suffix=gcc12-main
# nvidia/cuda tags by full patch version, which a FROM line
# can't derive from CUDA_VERSION; update the two together.
ARG cuda_base_image_tag=13.0.3-base-ubuntu24.04

# Empty placeholder for the optional artifacts build context: a
# `--build-context artifacts=<dir>` flag overrides this stage entirely;
# without the flag, the mount below sees zero files rather than erroring.
FROM scratch AS artifacts

# The official CUDA-Q container, pulled so its /opt/nvidia/cudaq
# install can be COPY'd into the builder and runtime stages.
FROM ${cudaq_image} AS cudaq-official

# ---------------------------------------------------------------------------
# Stage: toolchain -- RDMA/DOCA/Holoscan/TensorRT dev headers and an HSB
# source build needed to compile the decoding server, plus patchelf
# (needed at CMake configure time when decoder plugin .so artifacts are
# supplied). Also holds the cuda-quantum realtime source checkout the
# builder stage compiles.
# ---------------------------------------------------------------------------
FROM ${devcontainer_image}:${TARGETARCH}-cu${CUDA_VERSION}-${devcontainer_tag_suffix} AS toolchain

# Build tooling and RDMA userspace, plus what the qec build needs beyond
# the devcontainer: gfortran + libblas-dev (xtensor-blas), cuda-nvtx
# (profiling hooks), git-lfs. cuStabilizer needs no install: the
# devcontainer's cuquantum wheel already provides it where
# FindcuStabilizer.cmake looks.
RUN set -e; \
    CUDA_FULL_VERSION=$(nvcc --version | sed -n 's/^.*release \([0-9]\+\.[0-9]\+\).*$/\1/p'); \
    CUDA_VER_DASH=$(echo "$CUDA_FULL_VERSION" | sed 's/\./-/'); \
    apt-get update && apt-get install -y --no-install-recommends \
        ninja-build curl pkg-config jq patchelf \
        rdma-core ibverbs-providers \
        gfortran libblas-dev cuda-nvtx-$CUDA_VER_DASH git-lfs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# cuda-quantum realtime source. Used here for its dependency scripts and 
# again in the builder stage to compile cudaq-realtime itself.
COPY --from=cudaq-official /opt/nvidia/cudaq/build_info.txt /tmp/cudaq-build_info.txt
RUN set -e; \
    CUDAQ_SHA=$(sed -n 's/^source-sha: //p' /tmp/cudaq-build_info.txt); \
    test -n "$CUDAQ_SHA"; \
    echo "== cuda-quantum source: NVIDIA/cuda-quantum@$CUDAQ_SHA (from build_info.txt)"; \
    git clone --filter=blob:none --no-checkout https://github.com/NVIDIA/cuda-quantum.git /opt/cudaq-src; \
    git -C /opt/cudaq-src sparse-checkout init --cone; \
    git -C /opt/cudaq-src sparse-checkout set realtime cmake; \
    git -C /opt/cudaq-src checkout "$CUDAQ_SHA"; \
    rm -f /tmp/cudaq-build_info.txt

# DOCA GPUNetIO dev package, cuda-nvrtc-dev, the Holoscan SDK, and a
# holoscan-sensor-bridge (HSB) source build -- everything cudaq-realtime's
# gpu_roce bridge and cudaqx/qec's HSB tools compile against -- installed
# by cuda-quantum's own dependency script (the same one the cudaqx CI
# build uses), so the DOCA/Holoscan versions, the HSB ref, and the CUDA
# architectures HSB is compiled for live in one place. The arch list is
# derived from the toolkit version: Ampere+Hopper on CUDA 12, through
# Blackwell on CUDA 13. HSB lands at $HSB_ROOT with its build tree at
# $HSB_ROOT/build; the builder stage passes both paths to CMake.
ENV HSB_ROOT=/opt/holoscan-sensor-bridge
RUN set -e; \
    bash /opt/cudaq-src/realtime/scripts/install_devdeps.sh; \
    apt-get clean && rm -rf /var/lib/apt/lists/*; \
    test -d "$HSB_ROOT/build"

# TensorRT dev, pinned to the toolkit's CUDA flavor (needed at build time so
# CUDAQ_QEC_BUILD_TRT_DECODER=AUTO detects it). No arm64 packages exist for
# CUDA 12.x, only 13.x, so skip the install on that combination rather than
# fail the build -- trt_decoder just won't be built there (AUTO mode).
RUN set -e; \
    ARCH=$(uname -m); \
    CUDA_FULL_VERSION=$(nvcc --version | sed -n 's/^.*release \([0-9]\+\.[0-9]\+\).*$/\1/p'); \
    if [ "$ARCH" != "x86_64" ] && [ "${CUDA_FULL_VERSION%%.*}" = "12" ]; then \
        echo "== tensorrt-dev: skipping (no arm64 packages for CUDA 12.x)"; \
    else \
        apt-get update; \
        apt-cache search tensorrt \
            | awk -v v="$CUDA_FULL_VERSION" '{print "Package: "$1"\nPin: version *+cuda"v"\nPin-Priority: 1001\n"}' \
            > /etc/apt/preferences.d/tensorrt-cuda$CUDA_FULL_VERSION.pref; \
        apt-get install -y tensorrt-dev; \
        apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi

# ---------------------------------------------------------------------------
# Stage: builder -- compile cudaq-realtime (HSB tools ON, producing
# libcudaq-realtime-bridge-gpu-roce.so) and cudaqx/qec.
#
# Install prefixes are fixed absolute paths reused verbatim by the runtime
# stage: decoding_server's ELF carries absolute RPATH entries for the
# CUDA-Q and cudaq-realtime lib dirs (see
# libs/qec/tools/decoding-server/CMakeLists.txt INSTALL_RPATH), so those
# directories must land at the identical path in both stages.
# ---------------------------------------------------------------------------
FROM toolchain AS builder
ENV CUDAQ_INSTALL_PREFIX=/opt/nvidia/cudaq \
    CUDAQ_REALTIME_ROOT=/opt/nvidia/cudaq-realtime \
    CUDAQX_INSTALL_PREFIX=/opt/nvidia/cudaqx

# The official CUDA-Q install, at the same absolute path it occupies in
# the published container (load-bearing: RPATHs baked into what we build
# reference it, and the runtime stage ships it at this path).
COPY --from=cudaq-official /opt/nvidia/cudaq /opt/nvidia/cudaq

WORKDIR /workspaces/cudaqx
COPY . .

# cudaq-realtime, rebuilt with HSB tools ON from the source checked out in
# the toolchain stage (the consumed image's exact commit) and installed
# alongside the untouched CUDA-Q.
RUN set -e; \
    . scripts/cudaq_realtime_cmake_flags.sh; \
    cmake -G Ninja -S /opt/cudaq-src/realtime -B /tmp/realtime-build \
        -DCMAKE_INSTALL_PREFIX="$CUDAQ_REALTIME_ROOT" \
        -DCMAKE_CUDA_FLAGS="$(cudaq_realtime_cmake_cuda_flags)" \
        -DCUDAQ_REALTIME_ENABLE_HSB_TOOLS=ON \
        -DHOLOSCAN_SENSOR_BRIDGE_SOURCE_DIR="$HSB_ROOT" \
        -DHOLOSCAN_SENSOR_BRIDGE_BUILD_DIR="$HSB_ROOT/build"; \
    cmake --build /tmp/realtime-build; \
    cmake --install /tmp/realtime-build; \
    rm -rf /tmp/realtime-build

# cudaqx/qec itself: decoding_server, hsb_fpga_syndrome_playback, the QEC
# and realtime libraries, and the decoder plugins (built-in ones plus
# every libcudaq-qec-*-decoder.so in the artifacts context, passed via
# the QEC_EXTERNAL_DECODERS list). CUDAQX_INCLUDE_TESTS stays ON:
# hsb_fpga_syndrome_playback lives under unittests/utils/ and is only
# built when tests are enabled (the gtest binaries also compile but are
# never installed, so they don't ship).
#
# Plugins are copied out of the read-only artifacts mount because the
# build patchelfs each plugin's rpath in place at configure time. The
# cudevice archive is only ever read, so it's used from the mount as-is.
#
# CUDAQX_QEC_VERSION is the version string baked into libcudaq-qec.
ARG CUDAQX_QEC_VERSION
RUN --mount=type=bind,from=artifacts,target=/mnt/artifacts \
    set -e; \
    if [ -n "${CUDAQX_QEC_VERSION:-}" ]; then export CUDAQX_QEC_VERSION; else unset CUDAQX_QEC_VERSION; fi; \
    _cudevice_archive=""; \
    if [ -f /mnt/artifacts/libcudaq-qec-realtime-cudevice-proprietary.a ]; then \
        _cudevice_archive=/mnt/artifacts/libcudaq-qec-realtime-cudevice-proprietary.a; \
        echo "== cudevice archive: $_cudevice_archive"; \
    else \
        echo "== cudevice archive: absent (device_graph dispatch will not be linked)"; \
    fi; \
    _plugins=""; \
    mkdir -p /tmp/decoder-plugins; \
    for so in /mnt/artifacts/libcudaq-qec-*-decoder.so; do \
        [ -e "$so" ] || continue; \
        cp -f "$so" /tmp/decoder-plugins/; \
        _plugins="${_plugins:+$_plugins;}/tmp/decoder-plugins/$(basename "$so")"; \
    done; \
    if [ -n "$_plugins" ]; then \
        export QEC_EXTERNAL_DECODERS="$_plugins"; \
        echo "== external decoder plugins: $QEC_EXTERNAL_DECODERS"; \
    else \
        echo "== external decoder plugins: none supplied"; \
    fi; \
    cmake -S libs/qec -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER=gcc-12 \
        -DCMAKE_CXX_COMPILER=g++-12 \
        -DCUDAQ_DIR="$CUDAQ_INSTALL_PREFIX/lib/cmake/cudaq/" \
        -DCUDAQX_INCLUDE_TESTS=ON \
        -DCUDAQX_BINDINGS_PYTHON=OFF \
        -DCMAKE_INSTALL_PREFIX="$CUDAQX_INSTALL_PREFIX" \
        -DCUDAQ_REALTIME_ROOT="$CUDAQ_REALTIME_ROOT" \
        -DCUDAQX_QEC_ENABLE_HSB_TOOLS=ON \
        -DHOLOSCAN_SENSOR_BRIDGE_SOURCE_DIR="$HSB_ROOT" \
        -DHOLOSCAN_SENSOR_BRIDGE_BUILD_DIR="$HSB_ROOT/build" \
        ${_cudevice_archive:+-DCUDAQ_QEC_REALTIME_CUDEVICE_PROPRIETARY_ARCHIVE="$_cudevice_archive"}; \
    cmake --build build -j"$(nproc)"; \
    cmake --install build; \
    test -x "$CUDAQX_INSTALL_PREFIX/bin/decoding_server"; \
    test -x "$CUDAQX_INSTALL_PREFIX/bin/hsb_fpga_syndrome_playback"

# ---------------------------------------------------------------------------
# Stage: runtime -- minimal production image. No compilers, no -dev
# packages, no source tree.
# ---------------------------------------------------------------------------
FROM nvidia/cuda:${cuda_base_image_tag} AS runtime
ARG TARGETARCH
ARG CUDA_VERSION

# Runtime package set: RDMA userspace + libnl, the DOCA GPUNetIO runtime
# behind the gpu_roce transport, NVRTC (a hololink_core JIT dependency the
# CUDA "runtime" base lacks), libgomp (OpenMP runtime: decoding_server,
# libcudaq-qec and several CUDA-Q libs link it; the CUDA "runtime" base
# does not ship it), and the TensorRT runtime libs the trt_decoder plugin
# loads (libnvinfer, the ONNX parser, and the plugin library some ONNX
# models need), pinned to this CUDA flavor. Skipped on arm64+CUDA 12.x where
# no packages exist (the toolchain stage skips trt_decoder there too). The Holoscan SDK is NOT
# installed: HSB's hololink_core and gpu_roce_transceiver are linked
# statically into libcudaq-realtime-bridge-gpu-roce.so, and nothing
# shipped here has a runtime dependency on a Holoscan library (the apt
# package would also drag in nvcc and gcc via its dependency list).
# curl/gnupg are installed only to register the DOCA repo and purged
# afterwards.
RUN set -e; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && rm -rf /var/lib/apt/lists/*; \
    DOCA_ARCH=$(uname -m); case "$DOCA_ARCH" in aarch64|arm64) DOCA_ARCH="arm64-sbsa" ;; esac; \
    DOCA_REPO="https://linux.mellanox.com/public/repo/doca/3.3.0/ubuntu24.04/$DOCA_ARCH"; \
    curl -fsSL "$DOCA_REPO/GPG-KEY-Mellanox.pub" -o /usr/share/keyrings/GPG-KEY-Mellanox.pub; \
    echo "deb [signed-by=/usr/share/keyrings/GPG-KEY-Mellanox.pub] $DOCA_REPO /" \
        > /etc/apt/sources.list.d/doca.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends doca-sdk-gpunetio; \
    CUDA_MAJOR="${CUDA_VERSION%%.*}"; \
    CUDA_VER_DASH="$(echo "$CUDA_VERSION" | tr '.' '-')"; \
    apt-get install -y --no-install-recommends \
        rdma-core ibverbs-providers \
        cuda-nvrtc-${CUDA_VER_DASH} \
        libnl-3-200 libnl-route-3-200 \
        libgomp1; \
    if [ "$TARGETARCH" != "arm64" ] || [ "$CUDA_MAJOR" != "12" ]; then \
        apt-cache search tensorrt \
            | awk -v v="$CUDA_VERSION" '{print "Package: "$1"\nPin: version *+cuda"v"\nPin-Priority: 1001\n"}' \
            > /etc/apt/preferences.d/tensorrt-cuda$CUDA_VERSION.pref; \
        apt-get install -y --no-install-recommends \
            libnvinfer10 libnvinfer-plugin10 libnvonnxparsers10; \
    else \
        echo "== TensorRT runtime libs: skipping (no arm64 packages for CUDA 12.x)"; \
    fi; \
    apt-get purge -y curl gnupg; \
    apt-get autoremove -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /etc/apt/sources.list.d/doca.list /etc/apt/preferences.d/tensorrt-cuda$CUDA_VERSION.pref

# The three install trees, at the SAME absolute paths used in the builder
# stage (load-bearing: decoding_server's baked-in RPATH entries are
# absolute). Supplied decoder plugins are already inside the cudaqx tree,
# rpath-patched; the cudevice archive (if any) is already linked into
# decoding_server -- neither needs a separate COPY.
#
# From the official CUDA-Q install only lib/ (whole, so every library
# CUDA-Q might dlopen by name is present) and targets/ (the YAML target
# configs the platform layer reads if a target is ever selected) are
# shipped, plus the license files and build_info.txt for provenance. The
# rest of that install -- the nvq++/cudaq-* compiler binaries, headers,
# Python package and the binding/platform sources under src/ -- is
# build-time or user-facing material the server never reads. The
# shipped simulator backends' cuquantum wheel dependencies are not
# included; the decoding server never loads them.
COPY --from=cudaq-official /opt/nvidia/cudaq/lib /opt/nvidia/cudaq/lib
COPY --from=cudaq-official /opt/nvidia/cudaq/targets /opt/nvidia/cudaq/targets
COPY --from=cudaq-official /opt/nvidia/cudaq/LICENSES /opt/nvidia/cudaq/LICENSES
COPY --from=cudaq-official \
    /opt/nvidia/cudaq/LICENSE \
    /opt/nvidia/cudaq/NOTICE \
    /opt/nvidia/cudaq/Copyright.txt \
    /opt/nvidia/cudaq/build_info.txt \
    /opt/nvidia/cudaq/
COPY --from=builder /opt/nvidia/cudaq-realtime /opt/nvidia/cudaq-realtime
COPY --from=builder /opt/nvidia/cudaqx /opt/nvidia/cudaqx

# libcudaq-qec.so links cuStabilizer with an absolute RPATH into the
# cuquantum wheel's location, so this one file must land at the same path
# here. Just the single .so (it only depends on glibc); the rest of the
# wheel is unrelated cuQuantum components.
COPY --from=builder \
    /usr/local/lib/python3.12/dist-packages/cuquantum/lib/libcustabilizer.so.0 \
    /usr/local/lib/python3.12/dist-packages/cuquantum/lib/libcustabilizer.so.0

ENV CUDAQX_INSTALL_DIR=/opt/nvidia/cudaqx \
    CUDA_QUANTUM_PATH=/opt/nvidia/cudaq \
    CUDAQ_REALTIME_DIR=/opt/nvidia/cudaq-realtime \
    PATH=/opt/nvidia/cudaqx/bin:${PATH}

WORKDIR /opt/nvidia/cudaqx/bin
ENTRYPOINT ["/opt/nvidia/cudaqx/bin/decoding_server"]
