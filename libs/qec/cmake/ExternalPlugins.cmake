include_guard(GLOBAL)

# Stage a copy: release artifacts and their checksums must remain unchanged.
# Keep the legacy single-argument entry point for existing decoder deliveries.
function(add_target_libs_to_wheel plugin_library)
  cmake_parse_arguments(PARSE_ARGV 1 plugin "" "DESTINATION" "RPATH")
  if(plugin_UNPARSED_ARGUMENTS OR plugin_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "Invalid external plugin installation arguments.")
  endif()
  if(NOT EXISTS "${plugin_library}" OR IS_DIRECTORY "${plugin_library}")
    message(FATAL_ERROR "Invalid file path to external plugin: ${plugin_library}")
  endif()
  if(NOT plugin_DESTINATION)
    set(plugin_DESTINATION decoder-plugins)
  endif()
  if(NOT plugin_DESTINATION MATCHES "^(decoder-plugins|task-graph-plugins)$")
    message(FATAL_ERROR "Invalid external plugin destination: ${plugin_DESTINATION}")
  endif()
  if(NOT plugin_RPATH)
    set(plugin_RPATH "$ORIGIN/..")
  endif()
  foreach(path IN LISTS plugin_RPATH)
    if(NOT path MATCHES "^\\$ORIGIN(/[^:;\r\n]*)?$")
      message(FATAL_ERROR "External plugin RPATH must be relative to $ORIGIN.")
    endif()
  endforeach()
  find_program(QEC_PATCHELF_EXECUTABLE NAMES patchelf REQUIRED)
  get_filename_component(name "${plugin_library}" NAME)
  set(destination "${CMAKE_BINARY_DIR}/lib/${plugin_DESTINATION}/${name}")
  file(SHA256 "${plugin_library}" source_sha256)
  string(SHA256 identity "${destination}")
  get_property(installed GLOBAL PROPERTY QEC_EXTERNAL_PLUGIN_DESTINATIONS)
  set(already_installed FALSE)
  if(destination IN_LIST installed)
    get_property(previous_sha256 GLOBAL PROPERTY "QEC_EXTERNAL_${identity}_SHA256")
    if(NOT source_sha256 STREQUAL previous_sha256)
      message(FATAL_ERROR "Conflicting external plugin destination: ${destination}")
    endif()
    # Legacy and manifest deliveries can name the same immutable binary.
    # Install it once, retaining runtime paths required by either delivery.
    set(already_installed TRUE)
    get_property(previous_rpaths GLOBAL PROPERTY "QEC_EXTERNAL_${identity}_RPATH")
    list(APPEND plugin_RPATH ${previous_rpaths})
    list(REMOVE_DUPLICATES plugin_RPATH)
  else()
    set_property(GLOBAL APPEND PROPERTY QEC_EXTERNAL_PLUGIN_DESTINATIONS "${destination}")
    set_property(GLOBAL PROPERTY "QEC_EXTERNAL_${identity}_SHA256" "${source_sha256}")
  endif()
  get_filename_component(source "${plugin_library}" REALPATH)
  get_filename_component(target "${destination}" ABSOLUTE)
  if(source STREQUAL target)
    message(FATAL_ERROR "An external plugin cannot be its own staging destination.")
  endif()
  configure_file("${plugin_library}" "${destination}" COPYONLY)
  file(CHMOD "${destination}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  list(JOIN plugin_RPATH ":" rpath)
  execute_process(COMMAND "${QEC_PATCHELF_EXECUTABLE}" --set-rpath "${rpath}" "${destination}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to patch staged external plugin ${name}: ${error}")
  endif()
  set_property(GLOBAL PROPERTY "QEC_EXTERNAL_${identity}_RPATH" "${plugin_RPATH}")
  if(NOT already_installed)
    install(FILES "${destination}"
      DESTINATION "${CMAKE_INSTALL_LIBDIR}/${plugin_DESTINATION}"
      COMPONENT qec-lib-plugins)
  endif()
  message(STATUS "Installing external plugin ${name} in ${plugin_DESTINATION}")
endfunction()

foreach(option IN ITEMS QEC_EXTERNAL_DECODERS QEC_EXTERNAL_PLUGIN_ARCHIVE
    QEC_EXTERNAL_PLUGIN_FRAMEWORK_COMMIT QEC_EXTERNAL_PLUGIN_DELIVERY
    QEC_REQUIRED_EXTERNAL_PLUGINS)
  if(NOT DEFINED ${option} AND DEFINED ENV{${option}})
    set(${option} "$ENV{${option}}")
  endif()
endforeach()
set(QEC_EXTERNAL_PLUGIN_ARCHIVE "${QEC_EXTERNAL_PLUGIN_ARCHIVE}" CACHE FILEPATH
  "Optional checksummed external plugin archive")
set(QEC_EXTERNAL_PLUGIN_FRAMEWORK_COMMIT "${QEC_EXTERNAL_PLUGIN_FRAMEWORK_COMMIT}" CACHE STRING
  "Reviewed producer framework commit; provenance, not a runtime ABI check")
set(QEC_REQUIRED_EXTERNAL_PLUGINS "${QEC_REQUIRED_EXTERNAL_PLUGINS}" CACHE STRING
  "Semicolon-separated provider IDs required in the external plugin archive")
if(NOT QEC_EXTERNAL_PLUGIN_DELIVERY)
  if(SKBUILD)
    set(QEC_EXTERNAL_PLUGIN_DELIVERY wheel)
  else()
    set(QEC_EXTERNAL_PLUGIN_DELIVERY native)
  endif()
endif()
set(QEC_EXTERNAL_PLUGIN_DELIVERY "${QEC_EXTERNAL_PLUGIN_DELIVERY}" CACHE STRING
  "External plugin delivery layout (native or wheel)")
set_property(CACHE QEC_EXTERNAL_PLUGIN_DELIVERY PROPERTY STRINGS native wheel)

foreach(library IN LISTS QEC_EXTERNAL_DECODERS)
  add_target_libs_to_wheel("${library}")
endforeach()

if(QEC_EXTERNAL_PLUGIN_ARCHIVE)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "External plugin archives require a Linux ELF build.")
  endif()
  if(NOT QEC_EXTERNAL_PLUGIN_FRAMEWORK_COMMIT)
    message(FATAL_ERROR
      "An external plugin archive requires QEC_EXTERNAL_PLUGIN_FRAMEWORK_COMMIT. "
      "Confirm that this producer's plugin interfaces match the target framework; "
      "a source commit alone is not an ABI compatibility check.")
  endif()
  if(NOT QEC_EXTERNAL_PLUGIN_DELIVERY MATCHES "^(native|wheel)$")
    message(FATAL_ERROR "Invalid QEC_EXTERNAL_PLUGIN_DELIVERY.")
  endif()
  if(SKBUILD AND NOT QEC_EXTERNAL_PLUGIN_DELIVERY STREQUAL "wheel")
    message(FATAL_ERROR "A wheel build cannot import a native plugin archive.")
  elseif(NOT SKBUILD AND NOT QEC_EXTERNAL_PLUGIN_DELIVERY STREQUAL "native")
    message(FATAL_ERROR "A native build cannot import a wheel plugin archive.")
  endif()
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" architecture)
  if(architecture MATCHES "^(x86_64|amd64)$")
    set(architecture x86_64)
  elseif(architecture MATCHES "^(aarch64|arm64)$")
    set(architecture aarch64)
  else()
    message(FATAL_ERROR "Unsupported external plugin architecture: ${architecture}")
  endif()
  find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
  find_package(CUDAToolkit REQUIRED)
  get_filename_component(archive "${QEC_EXTERNAL_PLUGIN_ARCHIVE}" ABSOLUTE)
  if(NOT EXISTS "${archive}" OR IS_DIRECTORY "${archive}")
    message(FATAL_ERROR "External plugin archive does not exist: ${archive}")
  endif()
  file(SHA256 "${archive}" archive_sha256)
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/external-plugins")
  set(staging "${CMAKE_CURRENT_BINARY_DIR}/external-plugins/${archive_sha256}")
  set(importer "${CMAKE_CURRENT_LIST_DIR}/../../../scripts/ci/import_external_plugins.py")
  set(arguments --archive "${archive}" --output "${staging}" --reuse
    --delivery "${QEC_EXTERNAL_PLUGIN_DELIVERY}" --architecture "${architecture}"
    --cuda-version "${CUDAToolkit_VERSION}"
    --framework-commit "${QEC_EXTERNAL_PLUGIN_FRAMEWORK_COMMIT}")
  foreach(provider IN LISTS QEC_REQUIRED_EXTERNAL_PLUGINS)
    list(APPEND arguments --require "${provider}")
  endforeach()
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${importer}" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "External plugin import failed: ${output}${error}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${archive}" "${archive}.sha256" "${importer}")
  file(READ "${staging}/manifest.json" manifest)
  string(JSON count LENGTH "${manifest}" modules)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON path GET "${manifest}" modules ${index} path)
    string(JSON rpath_count LENGTH "${manifest}" modules ${index} rpath)
    set(rpaths "$ORIGIN/..")
    if(rpath_count GREATER 0)
      math(EXPR rpath_last "${rpath_count} - 1")
      foreach(rpath_index RANGE 0 ${rpath_last})
        string(JSON path_entry GET "${manifest}" modules ${index} rpath ${rpath_index})
        list(APPEND rpaths "${path_entry}")
      endforeach()
    endif()
    list(REMOVE_DUPLICATES rpaths)
    get_filename_component(directory "${path}" DIRECTORY)
    add_target_libs_to_wheel("${staging}/${path}"
      DESTINATION "${directory}" RPATH ${rpaths})
  endforeach()
  install(FILES "${staging}/manifest.json"
    DESTINATION "${CMAKE_INSTALL_LIBDIR}/external-plugins/${archive_sha256}"
    COMPONENT qec-lib-plugins RENAME source-manifest.json)
elseif(QEC_REQUIRED_EXTERNAL_PLUGINS)
  message(FATAL_ERROR "Required external plugins were requested without an archive.")
endif()
